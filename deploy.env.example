# Settings of ./deploy.sh. Copy to ~/.config/kidctl/deploy.env (or point
# KIDCTL_DEPLOY_ENV at your copy) and fill in; keep it out of the repository.
# Sourced by bash.

# Your infra repo checkout (GitOps source of the cluster) and the directory
# in it whose kustomization.yaml lists the kidctl image.
KIDCTL_DEPLOY_INFRA_DIR=~/src/infra
KIDCTL_DEPLOY_OVERLAY=apps/kidctl

# Registry the image is pushed to, as seen from this machine.
KIDCTL_DEPLOY_REGISTRY=registry.example.net:5000

# Optional: reach the registry through an SSH tunnel (ssh -L <spec> <host>),
# e.g. a registry that only listens inside the cluster's network.
#KIDCTL_DEPLOY_SSH_TUNNEL=5000:127.0.0.1:5000
#KIDCTL_DEPLOY_SSH_TUNNEL_HOST=cluster-node

# Optional, defaults shown.
#KIDCTL_DEPLOY_IMAGE=kidctl/server              # image repository in the registry
#KIDCTL_DEPLOY_KUSTOMIZE_NAME=kidctl-server     # images[].name in kustomization.yaml
#KIDCTL_DEPLOY_PLATFORM=linux/amd64
#KIDCTL_DEPLOY_BUILDER=kidctl-builder           # docker buildx builder
#KIDCTL_DEPLOY_COMMIT_PREFIX="deploy: kidctl"   # infra commit: "<prefix> @ <sha>"
